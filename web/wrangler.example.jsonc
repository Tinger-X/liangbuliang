{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liangbuliang",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liangbuliang",
      "database_id": "你的数据库ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "liangbuliang"
    }
  ]
}
